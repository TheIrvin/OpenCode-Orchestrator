{
  "$schema": "https://opencode.ai/config.json",

  // Default session model. Beam is the best strong "generalist"
  // free model (1M of context + variants up to `max`). The orchestrator and
  // subagents pick their own variant/reasoning in their definition.
  "model": "opencode/beam-free",

  // When opening the app, it starts in the flow's director.
  "default_agent": "orchestrator",

  // ---------------------------------------------------------------------------
  // Permissions (ordered rules: the last match wins).
  // Comfortable base for automation, with brakes on destructive actions.
  // ---------------------------------------------------------------------------
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item * -Recurse *", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" }
  ],

  // ---------------------------------------------------------------------------
  // Fine-tuning of built-in agents (merge by key: only changes the model).
  // ---------------------------------------------------------------------------
  "agents": {
    "build": { "model": "opencode/deepseek-v4.1-flash-free#high" },
    "general": { "model": "opencode/beam-free#high" },
    "explore": { "model": "opencode/nemotron-3.5-lightning-free" },
    "plan": { "model": "opencode/space-bunny-free#high" }
  },

  // ---------------------------------------------------------------------------
  // Compaction: preserves more recent detail (free models have
  // varied context budgets; DeepSeek/GLM/MiMo are 200k).
  // ---------------------------------------------------------------------------
  "compaction": {
    "auto": true,
    "keep": { "tokens": 24000 },
    "buffer": 20000
  },

  // ---------------------------------------------------------------------------
  // MCP servers. Context7 (library documentation, remote/OAuth).
  // Add more with:  opencode mcp add <name> --global --url <url>
  // Local ones are exposed via Code Mode (tools.<server>.<tool>).
  // ---------------------------------------------------------------------------
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      // Persistent memory (knowledge graph, JSONL). Survives across
      // sessions and is shared by all agents. On Windows npx must be launched
      // with "cmd /c" because npx.ps1 is blocked by policy.
      "memory": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
        "cwd": ".",
        "environment": {
          "MEMORY_FILE_PATH": ".orquestador/memory/graph.jsonl"
        }
      }
      // Ready-made examples to uncomment:
      // "sequential": {
      //   "type": "local",
      //   "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
      // },
      // "playwright": {
      //   "type": "local",
      //   "command": ["npx", "-y", "@playwright/mcp@latest"]
      // },
      // "github": {
      //   "type": "remote",
      //   "url": "https://api.githubcopilot.com/mcp/"
      // }
    }
  },

  // ---------------------------------------------------------------------------
  // Warming: keeps the provider cache warm between prompts.
  // Disabled by default (it consumes requests even when free).
  // Uncomment to enable:
  // ---------------------------------------------------------------------------
  // "warming": { "interval": "4 minutes", "duration": "30 minutes" },

  // Local worktrees (isolated parallel execution):
  "worktree": { "directory": "../.orquestador-trees" }
}
