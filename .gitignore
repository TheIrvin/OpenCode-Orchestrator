# --- OpenCode worktrees (write parallelism) ---
.orquestador-trees/

# --- Project memory: volatile files are not versioned ---
.orquestador/memory/*.jsonl
.orquestador/memory/plugin-*

# --- Credentials / environment: NEVER commit ---
.env
.env.*
!.env.example
service.json
